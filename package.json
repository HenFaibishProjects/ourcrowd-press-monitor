{
  "name": "ourcrowd-press-monitor",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": "^24.15.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names backend,frontend \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "build": "npm run build --workspace frontend && npm run build --workspace backend",
    "start": "npm run start:prod --workspace backend",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspace backend",
    "db:init": "npm run db:init --workspace backend",
    "companies": "npm run companies --workspace backend",
    "sentiment": "npm run sentiment --workspace backend --",
    "sentiment:test": "npm run sentiment --",
    "db": "npm run db:init",
    "companies:prepare": "npm run companies:prepare --workspace backend",
    "companies:setup": "npm run companies:prepare && npm run companies"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
